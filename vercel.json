{
  "version": 2,
  "rewrites": [
    {
      "source": "/batches.json",
      "destination": "/api/batches"
    },
    {
      "source": "/video",
      "destination": "/api/video"
    },
    {
      "source": "/pdf",
      "destination": "/api/pdf"
    },
    {
      "source": "/get/folder_contentsv3",
      "destination": "/api/folder_contentsv3"
    },
    {
      "source": "/get/fetchVideoDetailsById",
      "destination": "/api/fetchVideoDetailsById"
    },
    {
      "source": "/((?!api/|video|pdf|batches\\.json|metadata\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
